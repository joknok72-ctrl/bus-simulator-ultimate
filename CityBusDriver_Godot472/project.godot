; Engine configuration file.
; It's actually a file loaded by the engine.
; Godot Engine 4.7.2-stable project - City Bus Driver (original mobile bus driving game)

config_version=5

[application]

config/name="City Bus Driver"
config/name_localized={
"ar": "سائق حافلة المدينة"
}
config/description="Original 3D city bus driving game for Android phones. Pick up passengers, follow the route, drive safely and beat the clock."
config/version="1.0.0"
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.7", "Mobile")
boot_splash/bg_color=Color(0.07, 0.09, 0.14, 1)
boot_splash/image="res://assets/ui/splash.png"
boot_splash/fullsize=false
boot_splash/use_filter=true
config/icon="res://icon.svg"

[autoload]

GameState="*res://scripts/autoload/game_state.gd"
AudioSynth="*res://scripts/autoload/audio_synth.gd"

[debug]

gdscript/warnings/untyped_declaration=0
gdscript/warnings/unsafe_property_access=0
gdscript/warnings/unsafe_method_access=0

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/energy_saving/keep_screen_on=true

[gui]

theme/custom="res://theme/main_theme.tres"
theme/default_font_antialiasing=1
theme/default_font_hinting=1

[input]

