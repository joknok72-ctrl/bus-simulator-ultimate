[input_devices]

pointing/emulate_touch_from_mouse=true
pointing/emulate_mouse_from_touch=true
sensors/enable_accelerometer=true

[internationalization]

locale/translations=PackedStringArray("res://assets/i18n/strings.en.translation", "res://assets/i18n/strings.ar.translation")
locale/fallback="en"
rendering/root_node_layout_direction=0

[layer_names]

3d_physics/layer_1="World"
3d_physics/layer_2="Bus"
3d_physics/layer_3="Traffic"
3d_physics/layer_4="Zones"

[physics]

common/physics_ticks_per_second=60
3d/default_gravity=9.8

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
rendering_device/fallback_to_opengl3=true
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/size.mobile=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=1
environment/defaults/default_clear_color=Color(0.36, 0.56, 0.86, 1)
anti_aliasing/quality/msaa_3d=0
